# Draftly — server-side AI configuration
# Copy this file to `.env.local` and fill in a real key.
# The browser never receives these values: all AI calls go through /api/v1/*.

# Any OpenAI-compatible provider works.
AI_API_KEY=your-api-key-here

# DeepSeek:  https://api.deepseek.com
# OpenAI:    https://api.openai.com/v1
# SiliconFlow: https://api.siliconflow.cn/v1
AI_BASE_URL=https://api.deepseek.com

# Model name used for every request.
# DeepSeek: `deepseek-flash` or `deepseek-v4-pro`.
AI_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# Feedback + admin (server-only; never expose in client code)
# ---------------------------------------------------------------------------

# SQLite file. Relative paths resolve from the project root.
# Stores feedback and style profiles/samples. Use a persistent volume in production.
FEEDBACK_DB_PATH=.data/draftly.sqlite

# Style profiles need no extra key. Their samples are stored in the same SQLite
# file and scoped by an HttpOnly anonymous visitor cookie. PDF/DOCX text
# extraction runs on the server; no OCR service is used.

# Admin password for /admin/login. Replace with a long unique value.
ADMIN_PASSWORD=replace-with-a-long-random-password

# At least 32 characters. Signs the 8-hour HttpOnly admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Set true only when the site is served over HTTPS.
ADMIN_COOKIE_SECURE=false